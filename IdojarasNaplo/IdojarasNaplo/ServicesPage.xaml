<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IdojarasNaplo.ServicesPage"
             Title="ServicesPage"
             xmlns:local="clr-namespace:IdojarasNaplo">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <ResourceDictionary>
            <local:NullToFalseConverter x:Key="NullToFalseConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" WidthRequest="350" RowSpacing="8" Padding="0,05">
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Start">
            <Button Text="AverageTemperature:" Command="{Binding GetAvgTemperatureCommand}"/>
            <Label Text="{Binding AvgTemperature, StringFormat=' {0:F1} °C'}" HorizontalOptions="Center" FontSize="25" IsVisible="{Binding AvgTemperature, Converter={StaticResource NullToFalseConverter}}"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>