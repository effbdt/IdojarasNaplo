<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:IdojarasNaplo"
             x:Class="IdojarasNaplo.MainPage"
             x:DataType="local:MainPageViewModel">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="Black"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *" WidthRequest="350" RowSpacing="8" Padding="0,05">
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" Grid.Row="0">
            <Button Text="New" Command="{Binding NewDiaryEntryCommand}"/>
            <Button Text="Edit" Command="{Binding EditDiaryEntryCommand}"/>
            <Button Text="Delete" Command="{Binding DeleteEntryCommand}"/>
            <Button Text="Details" Command="{Binding ShowDiaryDetailsCommand}"/>
            <Button Text="Services" Command="{Binding GoToServicesPageCommand}"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10" Grid.Row="1">
            <Label Text="Detailed View" VerticalOptions="Center" TextColor="White"/>
            <Switch IsToggled="{Binding IsFullViewEnabled}"/>
        </HorizontalStackLayout>

        <Border StrokeThickness="2" Stroke="Brown" StrokeShape="RoundRectangle 10" Grid.Row="2">
            <CollectionView ItemsSource="{Binding Diaries}"
                            SelectedItem="{Binding SelectedDiary}"
                            SelectionMode="Single"
                            BackgroundColor="LightYellow">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Diary">
                        <Border Margin="5" Padding="5"
                                Stroke="Green" StrokeThickness="1">
                            <VerticalStackLayout>
                                <Label FontSize="Medium" FontAttributes="Bold" Text="{Binding Title}"/>
                                <Label FontSize="Small" Text="{Binding Body}" 
                                       IsVisible="{Binding BindingContext.IsFullViewEnabled, 
                                       Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>
                                <Label FontSize="Small" Text="{Binding Temperature, StringFormat='Temperature: {0} °C'}"/>
                                <Label FontSize="Small" Text="{Binding WeatherDescription}"
                                       IsVisible="{Binding BindingContext.IsFullViewEnabled,
                                       Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>
                                <Label FontSize="Small" Text="{Binding Date, StringFormat='{0:yyyy:MM:dd}'}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
